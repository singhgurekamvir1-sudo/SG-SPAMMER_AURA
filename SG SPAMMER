-- 5. COMMAND HANDLER
local function handleCmd(text, sender)
    local split = text:lower():split(" ")
    local cmd = split[1]
    local arg = split[2]
    
    if cmd == "!give" and arg then
        for _, p in pairs(players:GetPlayers()) do
            if p.Name:lower():find(arg) then ADMINS[p.Name] = true; chat("GTV V1: Admin Added " .. p.Name) end
        end
    elseif cmd == "!start" then active = true
    elseif cmd == "!stop" then active = false
    elseif cmd == "!sit" then
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then lp.Character.Humanoid.Sit = true end
    elseif cmd == "!kick" and arg then
        for _, p in pairs(players:GetPlayers()) do
            if p.Name:lower():find(arg) then chat("SG V1: Attempting to kick " .. p.Name) end
        end
    elseif cmd == "!say" and arg then
        chat(text:sub(6))
    elseif cmd == "!rj" then
        game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
    elseif cmd == "!cmds" then
        chat("!give, !start, !stop, !sit, !kick, !say, !rj")
    end
end

