-- 3. THE WALL BUILDER
local function buildWall(msg)
    local patterns = {"#- #", "@", "*_*"} 
    local p = patterns[patternStep]
    local currentText = " " .. msg
    local remainingSpace = 195 - #currentText
    local repeatCount = math.floor(remainingSpace / #p)
    
    local wall = string.rep(p, repeatCount) .. currentText
    patternStep = (patternStep >= 3) and 1 or (patternStep + 1)
    return wall
end

